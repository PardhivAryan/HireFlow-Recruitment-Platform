# Copy this file to .env and replace the password placeholders before starting Docker.
# Auth Service PostgreSQL
AUTH_POSTGRES_USER=hireflow_auth
AUTH_POSTGRES_PASSWORD=replace_with_auth_password
AUTH_POSTGRES_DB=hireflow_auth
AUTH_POSTGRES_HOST=127.0.0.1
AUTH_POSTGRES_PORT=5433

# Generate a secret with: openssl rand -hex 32
AUTH_JWT_SECRET=
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Auth-only recruiter creation. Generate a separate secret: openssl rand -hex 32
RECRUITER_CREATION_SECRET=

# Recruitment Service PostgreSQL
RECRUITMENT_POSTGRES_USER=hireflow_recruitment
RECRUITMENT_POSTGRES_PASSWORD=replace_with_recruitment_password
RECRUITMENT_POSTGRES_DB=hireflow_recruitment
RECRUITMENT_POSTGRES_HOST=127.0.0.1
RECRUITMENT_POSTGRES_PORT=5434
# Recruitment validates Auth tokens using the same AUTH_JWT_SECRET above.

# Interview Service PostgreSQL
INTERVIEW_POSTGRES_USER=hireflow_interview
INTERVIEW_POSTGRES_PASSWORD=replace_with_interview_password
INTERVIEW_POSTGRES_DB=hireflow_interview
INTERVIEW_POSTGRES_HOST=127.0.0.1
INTERVIEW_POSTGRES_PORT=5435

# Recruitment -> Interview, using the same internal secret in both services.
INTERVIEW_SERVICE_URL=http://127.0.0.1:8003
# Generate a separate secret with: openssl rand -hex 32
INTERNAL_SERVICE_SECRET=

# Redis for local Auth development. Docker uses DOCKER_REDIS_URL below.
REDIS_URL=redis://127.0.0.1:6379/0
AUTH_LOGIN_RATE_LIMIT=5
AUTH_REGISTER_RATE_LIMIT=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_PREFIX=hireflow:rate-limit

# Container-to-container connections. Local Python settings above remain unchanged.
DOCKER_AUTH_POSTGRES_HOST=auth-db
DOCKER_AUTH_POSTGRES_PORT=5432
DOCKER_RECRUITMENT_POSTGRES_HOST=recruitment-db
DOCKER_RECRUITMENT_POSTGRES_PORT=5432
DOCKER_INTERVIEW_POSTGRES_HOST=interview-db
DOCKER_INTERVIEW_POSTGRES_PORT=5432
DOCKER_REDIS_URL=redis://redis:6379/0
DOCKER_INTERVIEW_SERVICE_URL=http://interview-service:8000

# Published Docker host ports; change the matching local connection values if needed.
AUTH_HTTP_PORT=8001
RECRUITMENT_HTTP_PORT=8002
INTERVIEW_HTTP_PORT=8003
AUTH_DB_HOST_PORT=5433
RECRUITMENT_DB_HOST_PORT=5434
INTERVIEW_DB_HOST_PORT=5435
REDIS_HOST_PORT=6379
